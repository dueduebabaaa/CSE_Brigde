# ==============================================================================
# BRIDGE — 통합 협업 플랫폼 환경변수 템플릿 (.env.example)
# ==============================================================================
# 본 파일은 협업을 위한 환경변수 안내 파일입니다.
# 실제 개발 시에는 본 파일을 복사하여 '.env' 또는 '.env.local'을 생성하고 사용하세요.
# 주의: 실제 비밀 키(Service Role Key 등)는 절대로 Git에 커밋하지 마세요!
# ==============================================================================

# [Frontend] Supabase 공개 접속 정보 (브라우저 노출 가능)
# Supabase Project Dashboard > Project Settings > API 에서 확인 가능
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# [Frontend] 서비스 기본 정보
VITE_APP_TITLE=BRIDGE
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# [Crawler & Server Only] 서버 전용 환경변수 (절대 VITE_ 접두사 사용 금지!)
# 프론트엔드 번들에 절대 포함되면 안 되며, GitHub Actions Secrets 또는 로컬 서버 환경변수에만 설정합니다.
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-crawler
# CRAWLER_USER_AGENT=BRIDGE-KNU-Crawler/1.0 (+https://github.com/your-repo)
